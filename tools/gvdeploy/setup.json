{
    "tool": "gvdeploy",
    "version": "2.0.1",
    "description": "Execute commands and scripts across target sets",
    "deps": {
        "arch": [],
        "debian": []
    },
    "requires": [
        "gvcore"
    ],
    "install": {
        "targets": [
            {
                "type": "copy",
                "src": "files/gvdeploy.py",
                "dst": "~/.local/bin/gvdeploy",
                "chmod": "755"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/dep",
                "target": "~/.local/bin/gvdeploy"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/run",
                "target": "~/.local/bin/gvdeploy"
            }
        ]
    }
}