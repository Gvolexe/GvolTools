{
    "tool": "gvfirewallctl",
    "version": "1.2.2",
    "description": "Firewall baseline management (UFW/nftables)",
    "deps": {
        "arch": [],
        "debian": [
            "ufw"
        ]
    },
    "requires": [
        "gvcore"
    ],
    "install": {
        "targets": [
            {
                "type": "copy",
                "src": "files/gvfirewallctl.py",
                "dst": "~/.local/bin/gvfirewallctl",
                "chmod": "755"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/fw",
                "target": "~/.local/bin/gvfirewallctl"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/gvfw",
                "target": "~/.local/bin/gvfirewallctl"
            }
        ]
    }
}