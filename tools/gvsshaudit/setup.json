{
    "tool": "gvsshaudit",
    "version": "2.0.0",
    "description": "Audit SSH server config and access",
    "deps": {
        "arch": [
            "python-paramiko"
        ],
        "debian": [
            "python3-paramiko"
        ]
    },
    "requires": [
        "gvcore"
    ],
    "install": {
        "targets": [
            {
                "type": "copy",
                "src": "files/gvsshaudit.py",
                "dst": "~/.local/bin/gvsshaudit",
                "chmod": "755"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/sa",
                "target": "~/.local/bin/gvsshaudit"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/sshaudit",
                "target": "~/.local/bin/gvsshaudit"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/gvsa",
                "target": "~/.local/bin/gvsshaudit"
            }
        ]
    }
}