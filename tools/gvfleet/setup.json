{
    "tool": "gvfleet",
    "version": "1.1.3",
    "description": "Host inventory and selection engine for gvtools",
    "deps": {
        "arch": [],
        "debian": []
    },
    "requires": [
        "gvcore"
    ],
    "install": {
        "targets": [
            {
                "type": "copy",
                "src": "files/gvfleet.py",
                "dst": "~/.local/bin/gvfleet",
                "chmod": "755"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/fleet",
                "target": "~/.local/bin/gvfleet"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/gvf",
                "target": "~/.local/bin/gvfleet"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/f",
                "target": "~/.local/bin/gvfleet"
            }
        ]
    }
}