{
    "tool": "gvjournal",
    "version": "2.0.0",
    "description": "Fetch and filter systemd journal logs across hosts",
    "deps": {
        "arch": [],
        "debian": []
    },
    "requires": [
        "gvcore"
    ],
    "install": {
        "targets": [
            {
                "type": "copy",
                "src": "files/gvjournal.py",
                "dst": "~/.local/bin/gvjournal",
                "chmod": "755"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/jrnl",
                "target": "~/.local/bin/gvjournal"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/j",
                "target": "~/.local/bin/gvjournal"
            }
        ]
    }
}