{
    "tool": "gvhostbootstrap",
    "version": "1.2.7",
    "description": "Bootstrap hosts to secure baseline (init, harden, status)",
    "deps": {
        "arch": [
            "python-paramiko"
        ],
        "debian": [
            "python3-paramiko"
        ]
    },
    "requires": [
        "gvcore"
    ],
    "install": {
        "targets": [
            {
                "type": "copy",
                "src": "files/gvhostbootstrap.py",
                "dst": "~/.local/bin/gvhostbootstrap",
                "chmod": "755"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/hb",
                "target": "~/.local/bin/gvhostbootstrap"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/gvhb",
                "target": "~/.local/bin/gvhostbootstrap"
            }
        ]
    }
}