{
    "tool": "gvnginxctl",
    "version": "2.0.1",
    "description": "Nginx configuration testing and management",
    "deps": {
        "arch": [],
        "debian": []
    },
    "requires": [
        "gvcore"
    ],
    "install": {
        "targets": [
            {
                "type": "copy",
                "src": "files/gvnginxctl.py",
                "dst": "~/.local/bin/gvnginxctl",
                "chmod": "755"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/ngx",
                "target": "~/.local/bin/gvnginxctl"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/nx",
                "target": "~/.local/bin/gvnginxctl"
            }
        ]
    }
}