{
    "tool": "gvlogtriage",
    "version": "1.1.1",
    "description": "Auth/system log analysis (SSH, sudo, fail2ban)",
    "deps": {
        "arch": [],
        "debian": []
    },
    "requires": [
        "gvcore"
    ],
    "install": {
        "targets": [
            {
                "type": "copy",
                "src": "files/gvlogtriage.py",
                "dst": "~/.local/bin/gvlogtriage",
                "chmod": "755"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/lt",
                "target": "~/.local/bin/gvlogtriage"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/logtriage",
                "target": "~/.local/bin/gvlogtriage"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/gvlt",
                "target": "~/.local/bin/gvlogtriage"
            }
        ]
    }
}