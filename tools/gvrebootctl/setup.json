{
    "tool": "gvrebootctl",
    "version": "2.0.1",
    "description": "Detect reboots needed, coordinate safe reboots, validate services post-reboot",
    "deps": {
        "arch": [],
        "debian": []
    },
    "requires": [
        "gvcore"
    ],
    "install": {
        "targets": [
            {
                "type": "copy",
                "src": "files/gvrebootctl.py",
                "dst": "~/.local/bin/gvrebootctl",
                "chmod": "755"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/reboot",
                "target": "~/.local/bin/gvrebootctl"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/rb",
                "target": "~/.local/bin/gvrebootctl"
            }
        ]
    }
}