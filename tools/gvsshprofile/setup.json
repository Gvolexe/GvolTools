{
    "tool": "gvsshprofile",
    "version": "1.2.5",
    "description": "SSH connection profiles and config generation",
    "deps": {
        "arch": [],
        "debian": []
    },
    "requires": [
        "gvcore"
    ],
    "install": {
        "targets": [
            {
                "type": "copy",
                "src": "files/gvsshprofile.py",
                "dst": "~/.local/bin/gvsshprofile",
                "chmod": "755"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/sp",
                "target": "~/.local/bin/gvsshprofile"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/gvsp",
                "target": "~/.local/bin/gvsshprofile"
            }
        ]
    }
}