{
    "tool": "gvdotctl",
    "version": "1.2.3",
    "description": "Dotfile management and distribution",
    "deps": {
        "arch": [],
        "debian": []
    },
    "requires": [
        "gvcore"
    ],
    "install": {
        "targets": [
            {
                "type": "copy",
                "src": "files/gvdotctl.py",
                "dst": "~/.local/bin/gvdotctl",
                "chmod": "755"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/dt",
                "target": "~/.local/bin/gvdotctl"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/dot",
                "target": "~/.local/bin/gvdotctl"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/gvdt",
                "target": "~/.local/bin/gvdotctl"
            }
        ]
    }
}