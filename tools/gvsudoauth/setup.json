{
    "tool": "gvsudoauth",
    "version": "1.2.0",
    "description": "Sudo authentication configuration (password/NOPASSWD/SSH-agent)",
    "deps": {
        "arch": [],
        "debian": []
    },
    "requires": [
        "gvcore"
    ],
    "install": {
        "targets": [
            {
                "type": "copy",
                "src": "files/gvsudoauth.py",
                "dst": "~/.local/bin/gvsudoauth",
                "chmod": "755"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/gvsu",
                "target": "~/.local/bin/gvsudoauth"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/sudoauth",
                "target": "~/.local/bin/gvsudoauth"
            }
        ]
    }
}