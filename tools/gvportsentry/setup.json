{
    "tool": "gvportsentry",
    "version": "1.2.0",
    "description": "Port scanning and baseline comparison",
    "deps": {
        "arch": [],
        "debian": []
    },
    "requires": [
        "gvcore"
    ],
    "install": {
        "targets": [
            {
                "type": "copy",
                "src": "files/gvportsentry.py",
                "dst": "~/.local/bin/gvportsentry",
                "chmod": "755"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/ports",
                "target": "~/.local/bin/gvportsentry"
            },
            {
                "type": "symlink",
                "link": "~/.local/bin/gvps",
                "target": "~/.local/bin/gvportsentry"
            }
        ]
    }
}